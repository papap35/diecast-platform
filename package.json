{
  "name": "paddock64",
  "version": "0.1.0",
  "private": true,
  "description": "Paddock 64 — 模型車收藏電商平台（Web / Admin / API）",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @paddock64/api db:migrate",
    "db:deploy": "pnpm --filter @paddock64/api db:deploy",
    "db:seed": "pnpm --filter @paddock64/api db:seed",
    "openapi": "pnpm --filter @paddock64/api openapi && pnpm --filter @paddock64/api-client generate"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
