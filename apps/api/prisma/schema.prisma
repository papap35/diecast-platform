generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// 管理員與權限
// ─────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  roleId       String    @db.Uuid
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Role {
  id          String      @id @default(uuid(7)) @db.Uuid
  key         String      @unique
  name        String
  description String?
  /// 權限字串，例如 product:write、order:read
  permissions String[]
  /// 系統內建角色不可刪除
  isSystem    Boolean     @default(false)
  admins      AdminUser[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ─────────────────────────────────────────────
// 會員與登入工作階段
// ─────────────────────────────────────────────

enum MemberStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model Member {
  id             String            @id @default(uuid(7)) @db.Uuid
  email          String            @unique
  passwordHash   String
  name           String
  phone          String?
  locale         String            @default("zh-TW")
  status         MemberStatus      @default(ACTIVE)
  marketingOptIn Boolean           @default(false)
  /// 累計有效消費金額（新台幣），用於會員等級計算
  totalSpent     Int               @default(0)
  /// 會員等級，依累計消費自動升降級
  tier           MemberTier        @default(ROOKIE)
  tierUpdatedAt  DateTime?
  /// 公開車庫網址代稱（/garage/{handle}）
  garageHandle   String?           @unique
  garagePublic   Boolean           @default(false)
  lastLoginAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  cart           Cart?
  orders         Order[]
  wishlist       WishlistItem[]
  reminders      ReleaseReminder[]
  garage         GarageItem[]
  notifications  Notification[]

  @@index([createdAt])
  @@index([tier])
}

enum AuthSubject {
  MEMBER
  ADMIN
}

/// Refresh token 工作階段。每次刷新都輪替（rotation），同一 family 的舊 token 被重複使用時整個 family 作廢。
model AuthSession {
  id          String      @id @default(uuid(7)) @db.Uuid
  subjectType AuthSubject
  subjectId   String      @db.Uuid
  familyId    String      @db.Uuid
  tokenHash   String      @unique
  expiresAt   DateTime
  rotatedAt   DateTime?
  revokedAt   DateTime?
  userAgent   String?
  ip          String?
  createdAt   DateTime    @default(now())

  @@index([subjectType, subjectId])
  @@index([familyId])
}

// ─────────────────────────────────────────────
// 商品目錄
// ─────────────────────────────────────────────

model Brand {
  id           String             @id @default(uuid(7)) @db.Uuid
  slug         String             @unique
  name         String
  country      String?
  logoUrl      String?
  sortOrder    Int                @default(0)
  isActive     Boolean            @default(true)
  translations BrandTranslation[]
  products     Product[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model BrandTranslation {
  brandId     String @db.Uuid
  locale      String
  description String
  brand       Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([brandId, locale])
}

model Category {
  id           String                @id @default(uuid(7)) @db.Uuid
  slug         String                @unique
  parentId     String?               @db.Uuid
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryTree")
  sortOrder    Int                   @default(0)
  isActive     Boolean               @default(true)
  translations CategoryTranslation[]
  products     Product[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model CategoryTranslation {
  categoryId  String   @db.Uuid
  locale      String
  name        String
  description String?
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// REGULAR：現貨；PRE_ORDER：預購（到貨後出貨）；LIMITED：限量發售（開賣時間一到才能購買）
enum SaleType {
  REGULAR
  PRE_ORDER
  LIMITED
}

model Product {
  id               String               @id @default(uuid(7)) @db.Uuid
  slug             String               @unique
  sku              String               @unique
  brandId          String               @db.Uuid
  brand            Brand                @relation(fields: [brandId], references: [id])
  categoryId       String               @db.Uuid
  category         Category             @relation(fields: [categoryId], references: [id])
  /// 比例，例如 1:64
  scale            String
  /// 售價（新台幣，整數）
  price            Int
  compareAtPrice   Int?
  /// 可售庫存。下單時以條件式 UPDATE 原子扣減，避免超賣
  stock            Int                  @default(0)
  status           ProductStatus        @default(DRAFT)
  saleType         SaleType             @default(REGULAR)
  /// 開賣時間（限量發售）或預購開放時間
  releaseAt        DateTime?
  preorderClosesAt DateTime?
  expectedShipAt   DateTime?
  /// 會員等級優先購：達 earlyAccessTier 的會員可在 earlyAccessAt（早於 releaseAt）起購買
  earlyAccessTier  MemberTier?
  earlyAccessAt    DateTime?
  /// 庫存從 0 補回有貨的時間，用來通知把商品加入願望清單的會員
  restockedAt      DateTime?
  /// 每位會員限購數量（含已成立訂單）
  purchaseLimit    Int?
  isFeatured       Boolean              @default(false)
  /// 規格，例如 { "material": "Diecast", "wheels": "Rubber" }
  specs            Json?
  translations     ProductTranslation[]
  images           ProductImage[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  stockMovements   StockMovement[]
  wishlistedBy     WishlistItem[]
  reminders        ReleaseReminder[]
  garageItems      GarageItem[]
  events           Event[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, saleType])
  @@index([brandId])
  @@index([categoryId])
  @@index([releaseAt])
}

model ProductTranslation {
  productId   String  @db.Uuid
  locale      String
  name        String
  subtitle    String?
  description String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
}

model ProductImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @db.Uuid
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

enum StockMovementReason {
  ADMIN_ADJUSTMENT
  ORDER_PLACED
  ORDER_CANCELLED
  ORDER_EXPIRED
}

/// 庫存異動帳：每一次增減都留下紀錄與異動後餘額，方便對帳與追查超賣問題
model StockMovement {
  id        String              @id @default(uuid(7)) @db.Uuid
  productId String              @db.Uuid
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int
  balance   Int
  reason    StockMovementReason
  orderId   String?             @db.Uuid
  actorId   String?             @db.Uuid
  note      String?
  createdAt DateTime            @default(now())

  @@index([productId, createdAt])
}

// ─────────────────────────────────────────────
// 購物車與訂單
// ─────────────────────────────────────────────

model Cart {
  id        String     @id @default(uuid(7)) @db.Uuid
  memberId  String     @unique @db.Uuid
  member    Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  cartId    String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  addedAt   DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([cartId, productId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ShippingMethod {
  HOME_DELIVERY
  CVS_711
  CVS_FAMILY
  CVS_HILIFE
  CVS_OKMART
}

/// 電子發票：會員載具、手機條碼、自然人憑證、捐贈、公司（統編）
enum InvoiceType {
  MEMBER_CARRIER
  MOBILE_BARCODE
  CITIZEN_CERT
  DONATION
  COMPANY
}

model Order {
  id                  String         @id @default(uuid(7)) @db.Uuid
  orderNo             String         @unique
  memberId            String         @db.Uuid
  member              Member         @relation(fields: [memberId], references: [id])
  status              OrderStatus    @default(PENDING_PAYMENT)
  locale              String
  currency            String         @default("TWD")
  subtotal            Int
  shippingFee         Int
  discountTotal       Int            @default(0)
  total               Int
  shippingMethod      ShippingMethod
  recipientName       String
  recipientPhone      String
  recipientEmail      String
  postalCode          String?
  city                String?
  district            String?
  addressLine         String?
  cvsStoreId          String?
  cvsStoreName        String?
  cvsStoreAddress     String?
  invoiceType         InvoiceType
  invoiceCarrierNum   String?
  invoiceDonationCode String?
  invoiceTaxId        String?
  invoiceTitle        String?
  note                String?
  /// 未付款訂單的保留期限；逾期由排程取消並釋放庫存
  paymentDeadline     DateTime?
  paidAt              DateTime?
  shippedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  items               OrderItem[]
  payments            Payment[]
  events              OrderEvent[]
  shipment            Shipment?
  invoice             Invoice?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([memberId, createdAt])
  @@index([status, paymentDeadline])
  @@index([createdAt])
}

model OrderItem {
  id         String      @id @default(uuid(7)) @db.Uuid
  orderId    String      @db.Uuid
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String      @db.Uuid
  product    Product     @relation(fields: [productId], references: [id])
  sku        String
  /// 下單當下的商品名稱快照（依訂單語系）
  name       String
  imageUrl   String?
  saleType   SaleType
  unitPrice  Int
  quantity   Int
  lineTotal  Int
  garageItem GarageItem?

  @@index([orderId])
  @@index([productId])
}

enum PaymentProvider {
  MOCK
  ECPAY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Payment {
  id              String          @id @default(uuid(7)) @db.Uuid
  orderId         String          @db.Uuid
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        PaymentProvider
  status          PaymentStatus   @default(PENDING)
  /// 送給金流商的交易編號（綠界限 20 碼英數字），每次付款嘗試都不同
  merchantTradeNo String          @unique
  providerTradeNo String?
  amount          Int
  method          String?
  /// 付款完成後導回的前台網址（Web 或 App deep link）
  returnUrl       String?
  rawNotify       Json?
  paidAt          DateTime?
  failedReason    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([orderId])
}

enum ActorType {
  SYSTEM
  MEMBER
  ADMIN
}

/// 訂單事件軌跡（狀態變更、付款、備註），後台可完整追溯
model OrderEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @db.Uuid
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  actorType  ActorType
  actorId    String?
  message    String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

// ─────────────────────────────────────────────
// 物流與電子發票
// ─────────────────────────────────────────────

enum IntegrationProvider {
  MOCK
  ECPAY
}

enum ShipmentStatus {
  /// 物流單已建立，等待寄件
  CREATED
  /// 已寄件、配送中
  IN_TRANSIT
  /// 已到取件門市
  ARRIVED
  /// 已取件或已送達
  PICKED_UP
  /// 逾期未取或拒收，退回寄件人
  RETURNED
}

/// 物流單（綠界 C2C 店到店／宅配）。一筆訂單一張；退回後可重新建立
model Shipment {
  id               String              @id @default(uuid(7)) @db.Uuid
  orderId          String              @unique @db.Uuid
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider         IntegrationProvider
  logisticsType    String
  logisticsSubType String
  merchantTradeNo  String              @unique
  /// 綠界物流交易編號 AllPayLogisticsID
  logisticsId      String?
  /// 寄貨編號（超商）或託運單號（宅配）
  shipmentNo       String?
  validationNo     String?
  status           ShipmentStatus      @default(CREATED)
  statusCode       String?
  statusMessage    String?
  raw              Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

enum InvoiceStatus {
  /// 等待開立（付款成功後由排程開立，失敗會重試）
  PENDING
  ISSUED
  /// 訂單退款，等待作廢或開立折讓
  VOID_PENDING
  /// 已作廢（開立當期退款）
  VOIDED
  /// 已開立折讓單（跨期退款不能作廢）
  ALLOWANCE_ISSUED
  /// 開立前訂單就已退款，不需開立
  CANCELLED
}

/// 電子發票。付款成功後開立；退款時當期作廢、跨期開立折讓
model Invoice {
  id            String              @id @default(uuid(7)) @db.Uuid
  orderId       String              @unique @db.Uuid
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      IntegrationProvider
  status        InvoiceStatus       @default(PENDING)
  invoiceNo     String?
  invoiceDate   DateTime?
  randomNumber  String?
  allowanceNo   String?
  amount        Int
  /// 作廢或折讓完成時間
  reversedAt    DateTime?
  /// 開立／作廢的重試次數與下次重試時間；超過上限停止重試，由後台人工處理
  attempts      Int                 @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  raw           Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, nextAttemptAt])
}

// ─────────────────────────────────────────────
// 收藏玩家功能：會員等級、願望清單、發售提醒、我的車庫、通知、活動
// ─────────────────────────────────────────────

/// 會員等級（依累計消費）：新手車手 → 正式車手 → 冠軍車手 → 傳奇車手
enum MemberTier {
  ROOKIE
  DRIVER
  CHAMPION
  LEGEND
}

/// 願望清單；商品補貨時通知
model WishlistItem {
  memberId   String    @db.Uuid
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  productId  String    @db.Uuid
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// 最近一次補貨通知時間
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@id([memberId, productId])
  @@index([productId])
}

/// 發售提醒：開賣（符合優先購資格時為優先購開始）前通知
model ReleaseReminder {
  memberId   String    @db.Uuid
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  productId  String    @db.Uuid
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@id([memberId, productId])
  @@index([notifiedAt])
}

enum GarageCondition {
  /// 未拆封
  SEALED
  /// 已拆封、近全新
  OPENED
  /// 展示中
  DISPLAYED
  /// 有使用痕跡
  PLAYWORN
}

/// 我的車庫：收藏的車款。本站訂單完成取件後自動入庫，也可手動登錄其他來源的車款
model GarageItem {
  id          String          @id @default(uuid(7)) @db.Uuid
  memberId    String          @db.Uuid
  member      Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  productId   String?         @db.Uuid
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// 由訂單自動入庫的來源品項（訂單退貨時一併移除）
  orderItemId String?         @unique @db.Uuid
  orderItem   OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  /// 名稱、品牌與比例：本站商品為入庫時的快照（商品下架後仍可顯示），其他來源由會員填寫
  name        String
  brandName   String?
  scale       String?
  condition   GarageCondition @default(SEALED)
  quantity    Int             @default(1)
  /// 購入價（新台幣），只有本人看得到
  pricePaid   Int?
  acquiredAt  DateTime?
  note        String?
  isFavorite  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([memberId, createdAt])
}

enum NotificationType {
  ORDER_PAID
  ORDER_SHIPPED
  ORDER_ARRIVED
  ORDER_CANCELLED
  ORDER_REFUNDED
  RELEASE_REMINDER
  WISHLIST_RESTOCK
  TIER_UPGRADED
}

/// 站內通知（標題與內容依會員語系產生）
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  memberId  String           @db.Uuid
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  /// 前台路徑（不含語系），例如 /account/orders/P64…
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([memberId, createdAt])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

/// Email 外寄匣：與業務資料同一交易寫入，由排程寄出（交易成功才寄、寄信失敗不影響交易）
model EmailMessage {
  id             String      @id @default(uuid(7)) @db.Uuid
  to             String
  subject        String
  text           String
  notificationId String?     @db.Uuid
  status         EmailStatus @default(PENDING)
  attempts       Int         @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime    @default(now())

  @@index([status, createdAt])
}

enum EventType {
  /// 模型車展
  EXHIBITION
  /// 車聚、交流會
  MEETUP
  /// 新品發售活動
  LAUNCH
  /// 線上活動（直播開箱等）
  ONLINE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

/// 活動（車展、車聚、發售活動），與發售行事曆一起呈現
model Event {
  id            String             @id @default(uuid(7)) @db.Uuid
  slug          String             @unique
  type          EventType
  status        ContentStatus      @default(DRAFT)
  startsAt      DateTime
  endsAt        DateTime?
  venue         String?
  address       String?
  /// 外部報名或活動頁連結
  url           String?
  coverImageUrl String?
  /// 相關商品（例如發售活動的限量車款）
  productId     String?            @db.Uuid
  product       Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  translations  EventTranslation[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, startsAt])
}

model EventTranslation {
  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  locale  String
  title   String
  summary String
  body    String

  @@id([eventId, locale])
}
