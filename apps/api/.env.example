# ── 基本 ──
NODE_ENV=development
PORT=4000

# ── 資料庫與快取 ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paddock64
# 每個 API 執行個體的資料庫連線數
DATABASE_POOL_SIZE=10
# 託管資料庫（例如 Neon）使用 pooler 時，遷移需改用直連網址
# DIRECT_DATABASE_URL=
REDIS_URL=redis://localhost:6379

# ── 認證 ──（正式環境請用 openssl rand -base64 48 產生）
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ── 前端網址 ──
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
WEB_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# ── 流量控制 ──
# 每個 IP 每分鐘的請求上限（壓力測試時所有請求來自同一個 IP，需調高）
RATE_LIMIT_PER_MINUTE=300
# 限量發售的 Redis 預檢閘門；關閉只用於壓力測試對照（docs/load-testing.md）
DROP_GATE_ENABLED=true

# ── 金流 ──（mock：模擬付款；ecpay：綠界，測試環境帳號見 docs/payments.md）
PAYMENT_PROVIDER=mock
ECPAY_ENV=stage
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# ── 物流 ──（mock：模擬選店頁；ecpay：綠界 C2C 店到店，測試帳號 2000933）
LOGISTICS_PROVIDER=mock
ECPAY_LOGISTICS_MERCHANT_ID=
ECPAY_LOGISTICS_HASH_KEY=
ECPAY_LOGISTICS_HASH_IV=
SHIPPER_NAME=Paddock64
SHIPPER_PHONE=0223456789
SHIPPER_CELLPHONE=0912345678
SHIPPER_ZIP=106
SHIPPER_ADDRESS=臺北市大安區復興南路一段100號

# ── 電子發票 ──（mock：模擬發票號碼；ecpay：綠界 B2C 電子發票，測試帳號 2000132）
INVOICE_PROVIDER=mock
ECPAY_INVOICE_MERCHANT_ID=
ECPAY_INVOICE_HASH_KEY=
ECPAY_INVOICE_HASH_IV=

# ── Email ──（log：只寫入紀錄；resend：Resend HTTP API）
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM="Paddock 64 <noreply@paddock64.dev>"

SWAGGER_ENABLED=true
