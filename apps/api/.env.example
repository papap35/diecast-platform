# ── 基本 ──
NODE_ENV=development
PORT=4000

# ── 資料庫與快取 ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paddock64
# 託管資料庫（例如 Neon）使用 pooler 時，遷移需改用直連網址
# DIRECT_DATABASE_URL=
REDIS_URL=redis://localhost:6379

# ── 認證 ──（正式環境請用 openssl rand -base64 48 產生）
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ── 前端網址 ──
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
WEB_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# ── 訂單 ──（未付款訂單保留分鐘數，限量商品較短）
ORDER_PAYMENT_TIMEOUT_MINUTES=30
LIMITED_PAYMENT_TIMEOUT_MINUTES=10

# ── 金流 ──（mock：模擬付款；ecpay：綠界，測試環境帳號見 docs/payments.md）
PAYMENT_PROVIDER=mock
ECPAY_ENV=stage
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

SWAGGER_ENABLED=true
